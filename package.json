{
  "name": "@edubeam/plot",
  "version": "0.1.0",
  "description": "Vue 3 components that draw 2D structures and their analysis results (supports, loads, reactions, N/V/M diagrams, deformed shape) as SVG.",
  "author": {
    "name": "Jan Voříšek",
    "url": "https://github.com/janvorisek"
  },
  "license": "GPL-3.0",
  "homepage": "https://www.edubeam.app/plot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduBeamApp/plot.git"
  },
  "bugs": {
    "url": "https://github.com/EduBeamApp/plot/issues"
  },
  "keywords": [
    "structural-analysis",
    "fem",
    "finite-element",
    "vue",
    "svg",
    "beam",
    "frame",
    "truss",
    "bending-moment",
    "shear-force",
    "diagram",
    "edubeam"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "publint": "publint",
    "check:types": "attw --pack --profile esm-only",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run coverage && npm run build && npm run publint && npm run check:types",
    "release": "node scripts/release.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@edubeam/fem": "^0.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@edubeam/fem": "github:EduBeamApp/fem#9f357eb73a0112062c41f7a4ac698c4eae058964",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "publint": "^0.3.25",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
