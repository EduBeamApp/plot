{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "vue", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": { "browser": true, "es2022": true },
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**", ".screenshots/**"],
  "rules": {
    // The library speaks only through its components and return values.
    "no-console": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    // Vue: typed, compile-time props, emits and refs, as the components are written.
    "vue/define-props-declaration": ["error", "type-based"],
    "vue/define-emits-declaration": ["error", "type-based"],
    "vue/require-typed-ref": "error",
    "vue/prefer-import-from-vue": "error",
    "vue/no-import-compiler-macros": "error",
    // Its fix, toSorted(), is newer than the browsers the build targets (Chrome 107); every sort here is
    // of an array made for it.
    "unicorn/no-array-sort": "off",
    // Small helpers sit beside the code that reads them.
    "unicorn/consistent-function-scoping": "off",
    // Stylesheets are imported for their effect.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      // A test that looks up what it just built may assert it is there; a missing one fails the test anyway.
      "files": ["**/*.test.ts", "playground/**"],
      "rules": { "typescript/no-non-null-assertion": "off" }
    },
    {
      // Node scripts: they report, and the screenshot script borrows the app's Playwright by its path.
      "files": ["scripts/**", "*.config.ts"],
      "env": { "node": true },
      "rules": { "no-console": "off", "import/no-absolute-path": "off" }
    }
  ]
}
